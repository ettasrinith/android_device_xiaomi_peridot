<?xml version="1.0" encoding="UTF-8"?>
<!--
     Framework compatibility matrix entries for peridot vendor HALs
     (Lineage Health via Neotic interfaces fork + QTI qconfig service).
     Installed as a product VINTF fragment.
-->
<compatibility-matrix version="8.0" type="framework">
    <hal format="aidl" optional="true">
        <name>vendor.lineage.health</name>
        <version>1</version>
        <version>2</version>
        <interface>
            <name>IChargingControl</name>
            <instance>default</instance>
        </interface>
        <interface>
            <name>IFastCharge</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.qti.hardware.qconfig</name>
        <version>1</version>
        <version>2</version>
        <version>3</version>
        <version>4</version>
        <version>5</version>
        <interface>
            <name>IQConfig</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.xiaomi.hardware.aidlbgservice</name>
        <version>1</version>
        <interface>
            <name>IBGService</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.xiaomi.hardware.aon</name>
        <version>1</version>
        <interface>
            <name>IAlwaysOn</name>
            <instance>miaonservicehal</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.xiaomi.hardware.display.mihwcextension</name>
        <version>1</version>
        <interface>
            <name>IMiHwcExtension</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.xiaomi.hardware.displayfeature_aidl</name>
        <version>2</version>
        <interface>
            <name>IDisplayFeature</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.xiaomi.hardware.fx.tunnel</name>
        <version>1</version>
        <interface>
            <name>IMiFxTunnel</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.xiaomi.hardware.mlipay</name>
        <version>1</version>
        <interface>
            <name>IMlipayService</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.xiaomi.hardware.quickcamera</name>
        <version>1</version>
        <interface>
            <name>IQuickCameraService</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.xiaomi.sensor.citsensorservice</name>
        <version>1</version>
        <interface>
            <name>ICitSensorService</name>
            <instance>default</instance>
        </interface>
    </hal>
</compatibility-matrix>
